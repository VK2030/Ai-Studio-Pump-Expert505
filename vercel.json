{
  "version": 2,
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index?_path=$1"
    },
    {
      "source": "/((?!api/|assets/|stator.png|wheel.png|impeller.png|.*\\.png|.*\\.jpg|.*\\.jpeg|.*\\.svg|.*\\.js|.*\\.css|.*\\.ico).*)",
      "destination": "/index.html"
    }
  ]
}
